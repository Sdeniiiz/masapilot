# MasaPilot Çevresel Değişkenler Örneği (.env.example)

# Çalışma Zamanı Modu: Edge (Yerel Şube Düğümü - SQLite) veya Cloud (Merkezi SaaS - PostgreSQL)
RuntimeMode=Edge

# Veritabanı Bağlantı Dizgisi
# Edge modu için varsayılan SQLite: Data Source=masapilot.db;Cache=Shared
# Cloud modu için PostgreSQL: Host=localhost;Database=masapilot_cloud;Username=postgres;Password=YourPasswordHere;
ConnectionStrings__DefaultConnection=Data Source=masapilot.db;Cache=Shared

# JWT Kimlik Doğrulama
Jwt__Secret=MasaPilot_SuperSecretProductionKey_Minimum32CharactersRequired!
Jwt__Issuer=MasaPilot
Jwt__Audience=MasaPilotClient

# ASP.NET Core Dinleme Adresi ve Portu
ASPNETCORE_URLS=http://0.0.0.0:5000
